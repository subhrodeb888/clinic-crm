# ── Database ──────────────────────────────────────────────────
# Neon PostgreSQL connection string (the pgvector extension is required
# for document embeddings — see drizzle/0001_hot_morph.sql).
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# ── Authentication (Auth.js v5) ───────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth client credentials (Google Cloud Console → APIs & Services → Credentials).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Base URL of the app (the dev server runs on port 3001 — see package.json).
AUTH_URL="http://localhost:3001"
# Demo login (signing in as a seeded user from the login page) is available
# automatically under `next dev` only; it is never enabled in production
# builds (gated on NODE_ENV === "development"). No configuration needed.

# ── OpenAI ────────────────────────────────────────────────────
# Used for document embeddings (text-embedding-3-small) and AI features.
OPENAI_API_KEY=""

# ── Cloudflare R2 (document storage) ──────────────────────────
# Cloudflare dashboard → R2 → Manage R2 API Tokens.
# The account ID is shown on the R2 overview page.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

CRM_API_KEY=""
CRM_BASE_URL=""
